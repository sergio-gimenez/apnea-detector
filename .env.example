# The backend now authenticates a real operator account. There is no shared token.
# Create the account once the service is running:
#   docker compose exec api apnea-admin create-user <username>
# then sign in on the dashboard and scan the MFA QR to finish enrolment.

# Optional: only for a throwaway local run with authentication fully disabled.
# APNEA_ALLOW_INSECURE_DEV=1

# Optional: extra browser origins allowed to make state-changing requests,
# comma-separated (e.g. https://sleep.example.com). The request's own host is
# always allowed; set this only if a proxy rewrites it.
# APNEA_TRUSTED_ORIGINS=

# Optional: set to 1 ONLY when a trusted reverse proxy always sets X-Forwarded-For
# and the origin port is not otherwise reachable. It lets the login rate limiter
# bucket by real client IP; leaving it unset is the safe default.
# APNEA_TRUST_FORWARDED_FOR=1
